---
import type { CollectionEntry } from "astro:content";
import PageHeader from "../components/PageHeader.astro";
import ResourceLinks from "../components/ResourceLinks.astro";
import SmartLink from "../components/SmartLink.astro";

interface Props {
  entry: CollectionEntry<"trainings">;
  slug: string;
}

const { entry, slug } = Astro.props;
const data = entry.data;
const formatDate = (value: Date) => new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" }).format(value);
---

<PageHeader {slug} title={data.title} intro={data.summary} />
<div class="container content-layout training-layout">
  <p class="status-message">Informations reprises du site existant : faites confirmer le tarif, le lieu, les prérequis et les disponibilités avant de vous inscrire.</p>
  <section class="key-facts" aria-label="Informations pratiques">
    <dl>
      <div><dt>Public</dt><dd>{data.audience}</dd></div>
      <div><dt>Prérequis</dt><dd>{data.prerequisites}</dd></div>
      <div><dt>Durée</dt><dd>{data.duration}</dd></div>
      <div><dt>Lieu</dt><dd>{data.location}</dd></div>
      <div><dt>Tarif</dt><dd>{data.price}</dd></div>
    </dl>
  </section>
  <section class="prose">
    <h2>Objectifs</h2>
    <ul>{data.objectives.map((objective) => <li>{objective}</li>)}</ul>
    <h2>Programme</h2>
    <ol>{data.program.map((item) => <li>{item}</li>)}</ol>
  </section>
  <section id="inscription" aria-labelledby="training-dates">
    <h2 id="training-dates">Prochaines dates</h2>
    {data.dates.length > 0 ? (
      <ul class="date-list">
        {data.dates.map((item) => (
          <li>
            <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
            {item.endDate && <> au <time datetime={item.endDate.toISOString()}>{formatDate(item.endDate)}</time></>}
            {item.note && <span>{item.note}</span>}
          </li>
        ))}
      </ul>
    ) : <p>Aucune date confirmée n’est disponible sur ce site. Contactez la Fédération pour connaître les prochaines sessions.</p>}
    <SmartLink class="button button-dark" href={data.registrationUrl}>{data.registrationUrl === "/contact/" ? "Demander les modalités d’inscription" : "Ouvrir l’inscription à cette formation"}</SmartLink>
  </section>
  <ResourceLinks title="Documents de la formation" items={data.documents} />
</div>
