---
import site from "../content/site.json";
import SiteMenu from "./SiteMenu.astro";
import WeatherWidget from "./WeatherWidget.astro";
import { resolveUrl } from "../lib/urls";

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href={base} aria-label={`${site.shortName} — Accueil`}>
      <img src={resolveUrl(site.logo, base)} width="400" height="111" alt={site.name} />
    </a>
    <div class="header-controls">
      <WeatherWidget />
      <SiteMenu />
    </div>
  </div>
</header>
