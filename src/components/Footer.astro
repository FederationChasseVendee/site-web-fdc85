---
import site from "../content/site.json";
import SmartLink from "./SmartLink.astro";
import { resolveUrl } from "../lib/urls";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <img src={resolveUrl(site.logo, import.meta.env.BASE_URL)} width="400" height="111" alt="" />
      <p>{site.tagline}</p>
    </div>
    <div>
      <h2>Rubriques</h2>
      <ul>{site.navigation.map((item) => <li><SmartLink href={item.url}>{item.label}</SmartLink></li>)}</ul>
    </div>
    <div>
      <h2>Nous contacter</h2>
      <address>
        <SmartLink href={site.contact.phoneUrl}>{site.contact.phoneLabel}</SmartLink><br />
        <SmartLink href={`mailto:${site.contact.email}`}>{site.contact.email}</SmartLink><br />
        {site.contact.address}
      </address>
    </div>
    <div>
      <h2>Réseaux sociaux</h2>
      <ul>{site.socialLinks.map((item) => <li><SmartLink href={item.url}>{item.label}</SmartLink></li>)}</ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.footerText}</p>
    <SmartLink href="contact/">Contact</SmartLink>
    <SmartLink href="actualites/">Actualités</SmartLink>
    <SmartLink href="ressources/">Index des ressources</SmartLink>
    <SmartLink href="mentions-legales/">Mentions légales</SmartLink>
    <SmartLink href="rgpd/">Données personnelles</SmartLink>
    <SmartLink href="politique-cookies/">Cookies</SmartLink>
  </div>
</footer>
