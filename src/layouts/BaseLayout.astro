---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import site from "../content/site.json";
import { getUmamiConfig } from "../lib/umami.mjs";
import { buildIdentity } from "../lib/preview-identity.mjs";

interface Props {
  title: string;
  description: string;
  redirectTo?: string;
  image?: string;
  contentType?: "website" | "article";
  publishedTime?: Date;
}

const {
  title,
  description,
  redirectTo,
  image,
  contentType = "website",
  publishedTime,
} = Astro.props;
const pageTitle = title === "Accueil" ? `${site.shortName} — ${site.tagline}` : `${title} — ${site.shortName}`;
const canonical = new URL(redirectTo ?? Astro.url.pathname, Astro.site);
const favicon = `${import.meta.env.BASE_URL}favicon.png`.replace(/\/{2,}/g, "/");
const feed = `${import.meta.env.BASE_URL}feed.xml`.replace(/\/{2,}/g, "/");
const socialImage = image ? new URL(`${import.meta.env.BASE_URL}${image.replace(/^\/+/, "")}`.replace(/\/{2,}/g, "/"), Astro.site) : undefined;
const configuredUmami = getUmamiConfig(site.analytics);
const umami = buildIdentity.preview ? null : configuredUmami;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173f35" />
    <meta name="description" content={description} />
    {(redirectTo || buildIdentity.preview) && <meta name="robots" content="noindex, follow" />}
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title={`Actualités — ${site.shortName}`} href={feed} />
    <link rel="icon" type="image/png" href={favicon} />
    <meta property="og:type" content={contentType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <title>{pageTitle}</title>
    {umami && (
      <script
        is:inline
        data-umami-loader
        data-script-url={umami.scriptUrl}
        data-website-id={umami.websiteId}
        data-do-not-track="true"
      >
        // Embedded comparisons must not count as visits to the public site.
        if (window.self === window.top) {
          const loader = document.currentScript;
          const script = document.createElement("script");
          script.defer = true;
          script.src = loader.dataset.scriptUrl;
          script.dataset.websiteId = loader.dataset.websiteId;
          script.dataset.doNotTrack = loader.dataset.doNotTrack;
          document.head.append(script);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
