---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticlePage from "../templates/ArticlePage.astro";
import CrossroadsPage from "../templates/CrossroadsPage.astro";
import IndexPage from "../templates/IndexPage.astro";
import SpeciesPage from "../templates/SpeciesPage.astro";
import StandardPage from "../templates/StandardPage.astro";
import TrainingPage from "../templates/TrainingPage.astro";
import RedirectPage from "../templates/RedirectPage.astro";
import PageHeader from "../components/PageHeader.astro";
import SmartLink from "../components/SmartLink.astro";
import { descriptionForEntry, getTemplateEntries, originalSlug, titleForEntry, type TemplateEntry } from "../lib/content";
import { resolveUrl } from "../lib/urls";

interface Props {
  item: TemplateEntry;
  slug: string;
  legacyDestination?: string;
}

export async function getStaticPaths() {
  return (await getTemplateEntries()).flatMap(({ slug, ...item }) => {
    const legacySlug = originalSlug(item.entry.id);
    const page = { params: { slug }, props: { item, slug } };
    return legacySlug === slug ? [page] : [
      page,
      { params: { slug: legacySlug }, props: { item, slug: legacySlug, legacyDestination: `${slug}/` } },
    ];
  });
}

const { item, slug, legacyDestination } = Astro.props;
const title = titleForEntry(item);
const description = descriptionForEntry(item);
const redirectDestination = legacyDestination ?? (item.template === "redirect" ? item.entry.data.destination : undefined);
const redirectTo = redirectDestination
  ? resolveUrl(redirectDestination, import.meta.env.BASE_URL)
  : undefined;
const articleImage = item.template === "article" ? item.entry.data.image?.src : undefined;
const publishedTime = item.template === "article" ? item.entry.data.date : undefined;
---

<BaseLayout
  {title}
  {description}
  {redirectTo}
  image={articleImage}
  contentType={item.template === "article" ? "article" : "website"}
  {publishedTime}
>
  {legacyDestination ? (
    <>
      <PageHeader {slug} {title} intro="Cette page a une nouvelle adresse." />
      <div class="container content-layout"><SmartLink href={legacyDestination}>Continuer vers {title}</SmartLink></div>
    </>
  ) : (
    <>
      {item.template === "standard" && <StandardPage entry={item.entry} {slug} />}
      {item.template === "crossroads" && <CrossroadsPage entry={item.entry} {slug} />}
      {item.template === "article" && <ArticlePage entry={item.entry} {slug} />}
      {item.template === "species" && <SpeciesPage entry={item.entry} {slug} />}
      {item.template === "training" && <TrainingPage entry={item.entry} {slug} />}
      {item.template === "index" && <IndexPage entry={item.entry} {slug} />}
      {item.template === "redirect" && <RedirectPage entry={item.entry} {slug} />}
    </>
  )}
</BaseLayout>
