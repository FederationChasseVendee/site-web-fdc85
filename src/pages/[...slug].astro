---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteContent from "../components/rendering/SiteContent";
import { getRenderContext } from "../lib/editor/catalog.server";
import RedirectPage from "../templates/RedirectPage.astro";
import { descriptionForEntry, getTemplateEntries, titleForEntry, type TemplateEntry } from "../lib/content";

interface Props {
  item: TemplateEntry;
  slug: string;
}

export async function getStaticPaths() {
  return (await getTemplateEntries()).map(({ slug, ...item }) => ({
    params: { slug },
    props: { item, slug },
  }));
}

const { item, slug } = Astro.props;
const title = titleForEntry(item);
const description = descriptionForEntry(item);
const redirectTo = item.template === "redirect"
  ? `${import.meta.env.BASE_URL}${item.entry.data.destination.replace(/^\/+/, "")}`
  : undefined;
const articleImage = item.template === "article" ? item.entry.data.image?.src : undefined;
const publishedTime = item.template === "article" ? item.entry.data.date : undefined;
const context = getRenderContext();
const renderEntry = context.entries.find((entry) => entry.collection === item.entry.collection && entry.slug === slug);
if (!renderEntry) throw new Error(`Contenu de rendu manquant : ${item.entry.collection}/${slug}`);
---

<BaseLayout
  {title}
  {description}
  {redirectTo}
  image={articleImage}
  contentType={item.template === "article" ? "article" : "website"}
  {publishedTime}
>
  {item.template !== "redirect" && <SiteContent entry={renderEntry} context={context} />}
  {item.template === "redirect" && <RedirectPage entry={item.entry} {slug} />}
</BaseLayout>
