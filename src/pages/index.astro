---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartLink from "../components/SmartLink.astro";
import ProcedureFolders from "../components/ProcedureFolders.astro";
import { normalizeSlug } from "../lib/content";
import { formatFrenchDate, isArchivedArticle } from "../lib/news";

const currentArticles = (await getCollection("articles"))
  .filter((article) => !isArchivedArticle(article))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const activeAlerts = currentArticles.filter((article) => article.data.category === "Alertes").slice(0, 3);
const latestNews = currentArticles.filter((article) => article.data.category !== "Alertes").slice(0, 3);
---

<BaseLayout title="Accueil" description="Les démarches, les formations et les informations de la Fédération Départementale des Chasseurs de la Vendée.">
  <!-- THESIS: Un dossier ouvert par besoin, sans portail de profils.
  OWN-WORLD: Prune, lilas et ivoire ; trois dossiers de largeurs et profondeurs différentes.
  STORY: Reconnaître son action, ouvrir sa démarche, puis consulter les nouvelles.
  FIRST VIEWPORT: Menu complet, titre court sur fond prune, dossiers ouverts avec les huit actions.
  FORM: Composition v2-folders, piste 8 demandée par l’utilisateur ; direction provisoire. -->
  <section class="home-intro">
    <div class="container">
      <h1>Un dossier pour<br />chaque besoin.</h1>
      <p>Permis, démarches et découvertes :<br />vos repères pour la chasse en Vendée.</p>
      <SmartLink href="mes-demarches/">Toutes mes démarches <span aria-hidden="true">→</span></SmartLink>
    </div>
  </section>
  <div class="container home-folders"><ProcedureFolders /></div>

  {activeAlerts.length > 0 && (
    <section class="section alerts-section" aria-labelledby="alerts-title">
      <div class="container">
        <h2 id="alerts-title">Alertes publiées</h2>
        <p>Ces informations sont datées. Vérifiez les modalités actuelles auprès de la Fédération avant d’agir.</p>
        <div class="editorial-grid">
          {activeAlerts.map((article) => (
            <article>
              <h3><SmartLink href={`${normalizeSlug(article.id)}/`}>{article.data.title}</SmartLink></h3>
              <p class="news-date"><time datetime={article.data.date.toISOString()}>{formatFrenchDate(article.data.date)}</time></p>
              <p>{article.data.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section news-section" aria-labelledby="news-title">
    <div class="container">
      <div class="section-heading section-heading-row">
        <h2 id="news-title">À la une en Vendée</h2>
        <SmartLink href="actualites/">Toutes les actualités <span aria-hidden="true">→</span></SmartLink>
      </div>
      {latestNews.length > 0 ? (
        <div class="editorial-grid">
          {latestNews.map((article) => (
            <article>
              <h3><SmartLink href={`${normalizeSlug(article.id)}/`}>{article.data.title}</SmartLink></h3>
              <p class="news-date">Publié le <time datetime={article.data.date.toISOString()}>{formatFrenchDate(article.data.date)}</time> · {article.data.category}</p>
              <p>{article.data.summary}</p>
            </article>
          ))}
        </div>
      ) : <p>Les publications précédentes restent accessibles dans <SmartLink href="actualites/archives/">les archives des actualités</SmartLink>.</p>}
    </div>
  </section>

  <section class="section discovery-section" aria-labelledby="discovery-title">
    <div class="container discovery-layout">
      <div>
        <h2 id="discovery-title">La chasse, les femmes et les hommes, le territoire.</h2>
        <p>Comprendre la pratique et découvrir les actions de la Fédération.</p>
      </div>
      <ul class="discovery-links">
        <li><SmartLink href="devenir-chasseur/">Devenir chasseur <span aria-hidden="true">→</span></SmartLink></li>
        <li><SmartLink href="chasser-en-vendee/dates-de-chasse/">Consulter les dates de chasse <span aria-hidden="true">→</span></SmartLink></li>
        <li><SmartLink href="nature-et-biodiversite/">Découvrir la nature et la biodiversité <span aria-hidden="true">→</span></SmartLink></li>
        <li><SmartLink href="la-federation/">Connaître la Fédération <span aria-hidden="true">→</span></SmartLink></li>
      </ul>
    </div>
  </section>
</BaseLayout>
