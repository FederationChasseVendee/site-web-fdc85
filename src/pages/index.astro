---
import BaseLayout from "../layouts/BaseLayout.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
import SiteContent from "../components/rendering/SiteContent";
import { getRenderContext } from "../lib/editor/catalog.server";

const context = getRenderContext();
const home = context.entries.find((entry) => entry.collection === "home");
if (!home || home.collection !== "home") throw new Error("Contenu d’accueil manquant.");
---

<BaseLayout title={home.data.seo.title} description={home.data.seo.description}>
  <SiteContent entry={home} context={context}>
    <WeatherWidget />
  </SiteContent>
</BaseLayout>
